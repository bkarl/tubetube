<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Movie Player</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #000;
      font-family: sans-serif;
      overflow: hidden;
    }

    #container {
      position: relative;
      width: 100vw;
      height: 100vh;
    }

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #carousel {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 240px;
      background: rgba(0, 0, 0, 0.7);
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      overflow-x: auto;
      scroll-behavior: smooth;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      cursor: grab;
      user-select: none;
    }

    #carousel.visible {
      opacity: 1;
      pointer-events: auto;
    }

    .movie-card {
      flex: 0 0 25%; /* Show 4 items */
      height: 100%;
      border-radius: 12px;
      overflow: hidden;
    }

    .movie-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      user-drag: none;
      -webkit-user-drag: none;
    }

    #carousel::-webkit-scrollbar {
      display: none;
    }

    #carousel {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    video::-webkit-media-controls {
      display: none !important;
    }
    video {
      outline: none;
    }
  </style>
</head>
<body>

<div id="container">
  <video id="mainMovie" controls autoplay>
    <source src="video/{{video_path}}" type="video/mp4">
    Your browser does not support HTML5 video.
  </video>

  <div id="carousel">
    <!-- Replace image src with movie thumbnails -->
    {% for suggestion in suggestions %}
    <div class="movie-card" id="{{suggestion.video_id}}">
    <a href="movie-detail1.html"><img src="video/{{suggestion.path}}" alt="Next Movie"></a>
    </div>
    {% endfor %}
  </div>
</div>

<script>
  const video = document.getElementById('mainMovie');
  const carousel = document.getElementById('carousel');

  video.addEventListener('pause', () => {
    carousel.classList.add('visible');
  });

  video.addEventListener('play', () => {
    carousel.classList.remove('visible');
  });

  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let scrollStartX = 0;
  let clickedLink = null;
  let pointerMoved = false;

  carousel.addEventListener('pointerdown', (e) => {
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    scrollStartX = carousel.scrollLeft;
    pointerMoved = false;
    isDragging = true;

    const targetLink = e.target.id
    if (targetLink) {
      clickedLink = targetLink;
      // Prevent native browser click but allow scrolling
      e.preventDefault();
    }

    carousel.setPointerCapture(e.pointerId);
  });

  carousel.addEventListener('pointermove', (e) => {
    if (!isDragging) return;

    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;

    // Allow both horizontal and vertical tolerance
    if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
      pointerMoved = true;
    }

    carousel.scrollLeft = scrollStartX - dx;
  });

  carousel.addEventListener('pointerup', (e) => {
    if (clickedLink && !pointerMoved) {
      // Trigger navigation only if not dragged
      window.location.href = '?video_id='+clickedLink;
    }

    // Reset all
    isDragging = false;
    clickedLink = null;
    pointerMoved = false;
  });

  // Prevent default drag behavior on images
  carousel.querySelectorAll('img').forEach(img => {
    img.draggable = false;
  });

  // Toggle play/pause on direct tap/click
  video.addEventListener('click', (e) => {
    // Prevent default behavior just in case
    e.preventDefault();

    if (video.paused) {
      video.play();
    } else {
      video.pause();
    }
  });
</script>


</body>
</html>
